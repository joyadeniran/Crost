# Crost — environment contract (Vercel). Copy to .env.local for local dev.
# NEVER commit real values. On Vercel, set these in Project → Settings → Environment Variables.

# ─── Supabase (Auth + Postgres + Storage) ─────────────────────────────────────
# Project URL + anon key: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY (auth admin + storage). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string — use the *pooler* (transaction mode, port 6543) URL on Vercel:
# Supabase → Project Settings → Database → Connection string
DATABASE_URL=
# Private storage bucket for artifacts (created by the baseline migration)
SUPABASE_STORAGE_BUCKET=crost

# ─── Gemini (Google AI API key — https://aistudio.google.com/apikey) ──────────
GEMINI_API_KEY=
# Optional model overrides (default gemini/gemini-2.5-flash)
CLOUD_MODEL=
CLOUD_MODEL_WORKER=

# ─── Application URL ──────────────────────────────────────────────────────────
# Canonical origin, e.g. https://crosthq.com — used for OAuth redirects, CSRF
# allow-list and internal dispatch calls.
NEXT_PUBLIC_APP_URL=

# ─── Internal secrets (generate with: openssl rand -hex 32) ───────────────────
# Header secret for trusted server-to-server calls (falls back to the service role key).
WORKER_INTERNAL_SECRET=
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`. Cron routes 500 if unset.
CRON_SECRET=

# ─── Gmail send on approval (optional) ────────────────────────────────────────
# AES-256 key (64 hex chars = 32 bytes) that seals stored Google OAuth tokens. Required to
# connect Gmail — storing a token fails closed without it. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Google OAuth client for "Connect Gmail" (/api/connect/google/start). See GOOGLE_OAUTH_SETUP.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Marketing site (optional) ────────────────────────────────────────────────
# Server-side only. If set, waitlist signups are also added to this Brevo list.
BREVO_API_KEY=
BREVO_LIST_ID=
# Public analytics key (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
